#!/usr/bin/env python3
"""
DEV GOD-MODE Global CLI Manager
Allows managing packs, updating skills, and integrating with Claude Code, Antigravity, and Cursor.
"""

import sys
import os
import json
import shutil
import subprocess
from pathlib import Path

HOME = Path.home()
CLAUDE_SKILLS = HOME / ".claude" / "skills"
CLAUDE_AGENTS = HOME / ".claude" / "agents"
GEMINI_SKILLS = HOME / ".gemini" / "config" / "skills"
CACHE_REPO = HOME / ".cache" / "god-mode-repo"
STATE_FILE = HOME / ".claude" / ".god-mode-state.json"

GITHUB_REPO = "https://github.com/Gastonchevarria/god-mode.git"

BOLD = "\033[1m"
GREEN = "\033[0;32m"
BLUE = "\033[0;34m"
PURPLE = "\033[0;35m"
CYAN = "\033[0;36m"
YELLOW = "\033[1;33m"
RED = "\033[0;31m"
NC = "\033[0m"

def get_installed_source_dir():
    # If running from a cloned repo
    script_path = Path(__file__).resolve()
    candidate = script_path.parent.parent
    if (candidate / "skills").exists() and (candidate / "config" / "packs.json").exists():
        return candidate
    # Fallback to cache repo
    if (CACHE_REPO / "skills").exists():
        return CACHE_REPO
    return None

def ensure_repo_cache():
    if not CACHE_REPO.exists():
        print(f"{YELLOW}📥 Descargando repositorio god-mode en caché local...{NC}")
        CACHE_REPO.parent.mkdir(parents=True, exist_ok=True)
        subprocess.run(["git", "clone", "--depth", "1", GITHUB_REPO, str(CACHE_REPO)], check=True)
    return CACHE_REPO

