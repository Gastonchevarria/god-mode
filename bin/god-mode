def load_packs(repo_dir):
    if repo_dir:
        packs_file = repo_dir / "config" / "packs.json"
        if packs_file.exists():
            try:
                with open(packs_file, "r", encoding="utf-8") as f:
                    return json.load(f).get("packs", DEFAULT_PACKS)
            except Exception:
                pass
    return DEFAULT_PACKS

def load_state():
    if STATE_FILE.exists():
        try:
            with open(STATE_FILE, "r", encoding="utf-8") as f:
                return json.load(f)
        except Exception:
            pass
    return {"active_pack": "core"}

def save_state(state):
    STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
    with open(STATE_FILE, "w", encoding="utf-8") as f:
        json.dump(state, f, indent=2)

def apply_pack(pack_name):
    repo_dir = get_installed_source_dir()
    if not repo_dir:
        repo_dir = ensure_repo_cache()

    packs = load_packs(repo_dir)
    if pack_name not in packs and pack_name != "all":
        print(f"{RED}❌ Pack '{pack_name}' desconocido. Opciones válidas: core, dev, growth, all{NC}")
        sys.exit(1)

    all_skills_dir = repo_dir / "skills"
    selected_skills = []

    if pack_name == "all":
        selected_skills = [s.name for s in all_skills_dir.iterdir() if s.is_dir()]
    else:
        pack_list = packs.get(pack_name, [])
        selected_skills = [s for s in pack_list if (all_skills_dir / s).exists()]

    print(f"\n{PURPLE}{BOLD}⚡ Aplicando Pack '{pack_name.upper()}' ({len(selected_skills)} skills seleccionadas)...{NC}")

    CLAUDE_SKILLS.mkdir(parents=True, exist_ok=True)
    GEMINI_SKILLS.mkdir(parents=True, exist_ok=True)

    # Clean existing god-mode managed skills that are symlinks
    for item in list(CLAUDE_SKILLS.iterdir()):
        if item.is_symlink():
            target = item.resolve()
            if "god-mode" in str(target) or str(repo_dir) in str(target):
                item.unlink()

    # Link selected skills
    linked = 0
    for s_name in selected_skills:
        src = all_skills_dir / s_name
        dest_claude = CLAUDE_SKILLS / s_name
        dest_gemini = GEMINI_SKILLS / s_name

        if not dest_claude.exists():
            dest_claude.symlink_to(src, target_is_directory=True)
            linked += 1

        if not dest_gemini.exists():
            dest_gemini.symlink_to(src, target_is_directory=True)

    # Save state
    save_state({"active_pack": pack_name, "skills_count": len(selected_skills)})

    print(f"{GREEN}✓ Pack '{pack_name}' activado con éxito.{NC}")
    print(f"  • Claude Code: {len(list(CLAUDE_SKILLS.iterdir()))} skills totales activas")
    print(f"  • Antigravity: {len(list(GEMINI_SKILLS.iterdir()))} skills totales activas")
    print(f"{CYAN}💡 Cero Context Bloat: Tu ventana de contexto ahora está 100% optimizada.{NC}\n")

def cmd_update():
    print(f"\n{BOLD}{PURPLE}🔄 Actualizando god-mode desde GitHub...{NC}")
    repo_dir = get_installed_source_dir()
    if repo_dir and (repo_dir / ".git").exists():
        subprocess.run(["git", "pull", "--rebase"], cwd=repo_dir, check=False)
    else:
        repo_dir = ensure_repo_cache()
        subprocess.run(["git", "pull", "--rebase"], cwd=repo_dir, check=False)

    state = load_state()
    active_pack = state.get("active_pack", "core")
    print(f"{BLUE}Re-aplicando pack activo: {active_pack}...{NC}")
    apply_pack(active_pack)
    print(f"{GREEN}{BOLD}🎉 ¡god-mode actualizado a la última versión!{NC}\n")

def cmd_status():
    state = load_state()
    active_pack = state.get("active_pack", "core")
    claude_count = len(list(CLAUDE_SKILLS.iterdir())) if CLAUDE_SKILLS.exists() else 0
    claude_agents = len(list(CLAUDE_AGENTS.iterdir())) if CLAUDE_AGENTS.exists() else 0
    gemini_count = len(list(GEMINI_SKILLS.iterdir())) if GEMINI_SKILLS.exists() else 0

    print(f"""
{PURPLE}{BOLD}⚡ DEV GOD-MODE STATUS{NC}
────────────────────────────────────────────────────
  • Pack Activo:         {GREEN}{BOLD}{active_pack.upper()}{NC}
  • Claude Code Skills:  {CYAN}{claude_count}{NC}
  • Subagentes Activos:  {CYAN}{claude_agents}{NC}
  • Antigravity Skills:  {CYAN}{gemini_count}{NC}
  • Protocolo:           {GREEN}Fable 5.1 (Never Stop Short){NC}
────────────────────────────────────────────────────
Packs disponibles:
  • {BOLD}core{NC}     (20 skills)  - Indispensables Fullstack/Security/Clean Code
  • {BOLD}dev{NC}      (57 skills)  - Fullstack, Backend, AI Pipelines, Testing
  • {BOLD}growth{NC}   (72 skills)  - SaaS Growth, Monetización, SEO, CRO, Ads
  • {BOLD}all{NC}      (135 skills) - Suite completa incluyendo video y media

Para cambiar de pack:
  god-mode pack <core|dev|growth|all>
""")

def cmd_cursor(target_dir="."):
    repo_dir = get_installed_source_dir() or ensure_repo_cache()
    cursorrules_src = repo_dir / "config" / ".cursorrules"
    agents_src = repo_dir / "config" / "AGENTS.md"

    target_path = Path(target_dir).resolve()
    print(f"{BOLD}Inyectando configuración GOD-Mode para Cursor y Windsurf en:{NC} {target_path}")

    if cursorrules_src.exists():
        shutil.copy2(cursorrules_src, target_path / ".cursorrules")
        print(f"  {GREEN}✓ Creado {target_path / '.cursorrules'}{NC}")

    if agents_src.exists():
        shutil.copy2(agents_src, target_path / "AGENTS.md")
        print(f"  {GREEN}✓ Creado {target_path / 'AGENTS.md'}{NC}")

    print(f"{GREEN}🎉 ¡Cursor y Windsurf ahora operan bajo el protocolo DEV GOD-MODE Fable 5.1!{NC}\n")

def main():
    if len(sys.argv) < 2 or sys.argv[1] in ["-h", "--help", "help"]:
        print(f"""
{PURPLE}{BOLD}⚡ god-mode CLI — Gestor Universal de la Suite DEV GOD-MODE{NC}

{BOLD}Uso:{NC}
  god-mode <comando> [opciones]

{BOLD}Comandos Disponibles:{NC}
  {CYAN}status{NC}                 Muestra el estado del sistema, pack activo y skills cargadas.
  {CYAN}pack <nombre>{NC}          Cambia el pack activo ({BOLD}core{NC} | {BOLD}dev{NC} | {BOLD}growth{NC} | {BOLD}all{NC}).
  {CYAN}update{NC}                 Actualiza god-mode a la última versión de GitHub.
  {CYAN}cursor [ruta]{NC}          Inyecta .cursorrules y AGENTS.md en el proyecto actual.
  {CYAN}add <github-url>{NC}       Descarga e instala una nueva skill desde GitHub.
        """)
        sys.exit(0)

    cmd = sys.argv[1].lower()

    if cmd == "status":
        cmd_status()
    elif cmd == "pack":
        if len(sys.argv) < 3:
            print(f"{RED}Especifica un pack: core, dev, growth, all{NC}")
            sys.exit(1)
        apply_pack(sys.argv[2].lower())
    elif cmd == "update":
        cmd_update()
    elif cmd == "cursor":
        target = sys.argv[2] if len(sys.argv) > 2 else "."
        cmd_cursor(target)
    elif cmd == "add":
        if len(sys.argv) < 3:
            print(f"{RED}Especifica una URL de GitHub. Ej: god-mode add https://github.com/...{NC}")
            sys.exit(1)
        installer = HOME / ".claude" / "scripts" / "install-skill.py"
        subprocess.run([sys.executable, str(installer), sys.argv[2]])
    else:
        print(f"{RED}Comando desconocido: {cmd}. Ejecuta 'god-mode --help'{NC}")
        sys.exit(1)

if __name__ == "__main__":
    main()
