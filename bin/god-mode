#!/usr/bin/env python3
"""
DEV GOD-MODE Global CLI Manager
Manages packs, protocol files, agents and updates for Claude Code, Antigravity and Cursor.
"""

import datetime
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

HOME = Path.home()
CLAUDE_DIR = HOME / ".claude"
CLAUDE_SKILLS = CLAUDE_DIR / "skills"
CLAUDE_AGENTS = CLAUDE_DIR / "agents"
CLAUDE_SCRIPTS = CLAUDE_DIR / "scripts"
CLAUDE_MD = CLAUDE_DIR / "CLAUDE.md"
GEMINI_DIR = HOME / ".gemini"
GEMINI_SKILLS = GEMINI_DIR / "config" / "skills"
GEMINI_RULES = GEMINI_DIR / "config" / "rules" / "dev_god_mode.md"
# Installers before 1.0 copied skill packs here and linked each skill from it. Antigravity loads every
# folder here as a plugin, so an old copy keeps loading next to the linked skills.
LEGACY_GEMINI_PLUGINS = GEMINI_DIR / "config" / "plugins"
CACHE_REPO = HOME / ".cache" / "god-mode-repo"
STATE_FILE = CLAUDE_DIR / ".god-mode-state.json"
LOCAL_BIN = HOME / ".local" / "bin" / "god-mode"
# Older installers also copied the CLI here; an outdated copy earlier on PATH could still run.
LEGACY_BIN = Path(os.environ.get("GOD_MODE_LEGACY_BIN", "/usr/local/bin/god-mode"))

GITHUB_REPO = os.environ.get("GOD_MODE_REPO_URL", "https://github.com/Gastonchevarria/god-mode.git")

BLOCK_START = "<!-- god-mode:start (bloque gestionado por god-mode; se reemplaza en cada update) -->"
BLOCK_END = "<!-- god-mode:end -->"
LEGACY_HEADER = re.compile(r"^# Global Instructions — .*\(Fable 5\.1 Tier\)\s*$", re.MULTILINE)

BOLD = "\033[1m"
GREEN = "\033[0;32m"
BLUE = "\033[0;34m"
PURPLE = "\033[0;35m"
CYAN = "\033[0;36m"
YELLOW = "\033[1;33m"
RED = "\033[0;31m"
NC = "\033[0m"


def fail(msg, code=1):
    print(f"{RED}❌ {msg}{NC}", file=sys.stderr)
    sys.exit(code)


def run_git(args, cwd=None, capture=False):
    try:
        return subprocess.run(["git", *args], cwd=cwd, capture_output=capture, text=True, check=False)
    except FileNotFoundError:
        fail("git no está instalado o no está en el PATH.")


def atomic_write(path, text):
    """Write text to path (following a symlink to its target) without ever leaving a half-written file."""
    target = path.resolve() if path.is_symlink() else path
    target.parent.mkdir(parents=True, exist_ok=True)
    tmp = target.with_name(f".{target.name}.god-mode-tmp-{os.getpid()}")
    tmp.write_text(text, encoding="utf-8")
    if target.exists():
        shutil.copymode(target, tmp)
    os.replace(tmp, target)


def load_state():
    if STATE_FILE.exists():
        try:
            return json.loads(STATE_FILE.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            print(f"{YELLOW}⚠️  No se pudo leer {STATE_FILE}; se usan valores por defecto.{NC}")
    return {}


def save_state(**changes):
    state = load_state()
    state.update(changes)
    STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
    STATE_FILE.write_text(json.dumps(state, indent=2), encoding="utf-8")


def is_repo(path):
    return path is not None and (path / "config" / "packs.json").exists()


def source_dir():
    """Repo the CLI manages: the one recorded at install, a repo containing this script, or the cache."""
    recorded = load_state().get("source_dir")
    if recorded and is_repo(Path(recorded)):
        return Path(recorded)
    here = Path(__file__).resolve().parent.parent
    if is_repo(here):
        return here
    if is_repo(CACHE_REPO):
        return CACHE_REPO
    return None


def ensure_source_dir():
    repo = source_dir()
    if repo:
        return repo
    print(f"{YELLOW}📥 Descargando god-mode en {CACHE_REPO}...{NC}")
    CACHE_REPO.parent.mkdir(parents=True, exist_ok=True)
    res = run_git(["clone", "--depth", "1", "--", GITHUB_REPO, str(CACHE_REPO)])
    if res.returncode != 0 or not is_repo(CACHE_REPO):
        fail("No se pudo descargar el repositorio de god-mode. Revisá tu conexión y que git esté instalado.")
    remember_source(CACHE_REPO)
    return CACHE_REPO


def remember_source(repo):
    """Record repo as the active source and as a root whose links god-mode owns."""
    repo = str(Path(os.path.abspath(repo)))
    roots = load_state().get("managed_roots", [])
    if repo not in roots:
        roots.append(repo)
    save_state(source_dir=repo, managed_roots=roots)


def managed_roots(repo):
    roots = {Path(r) for r in load_state().get("managed_roots", [])}
    return roots | {Path(os.path.abspath(repo)), Path(os.path.abspath(CACHE_REPO))}


def discover_skills(repo):
    """Map skill name -> directory, for both skills/<name> and plugins/<plugin>/skills/<name> layouts."""
    found = {}
    for skill_md in sorted(list(repo.glob("skills/*/SKILL.md")) + list(repo.glob("plugins/*/skills/*/SKILL.md"))):
        found[skill_md.parent.name] = skill_md.parent
    return found


def discover_agents(repo):
    return sorted(list(repo.glob("agents/*.md")) + list(repo.glob("plugins/*/agents/*.md")))


def load_packs(repo):
    packs_file = repo / "config" / "packs.json"
    try:
        packs = json.loads(packs_file.read_text(encoding="utf-8"))["packs"]
    except (OSError, json.JSONDecodeError, KeyError) as e:
        fail(f"No se pudo leer {packs_file}: {e}")
    return packs


def pack_skills(repo, pack_name):
    packs = load_packs(repo)
    available = discover_skills(repo)
    if pack_name not in packs:
        fail(f"Pack '{pack_name}' desconocido. Opciones válidas: {', '.join(packs)}")
    if packs[pack_name] == "ALL":
        return available, []
    selected = {n: available[n] for n in packs[pack_name] if n in available}
    missing = [n for n in packs[pack_name] if n not in available]
    return selected, missing


def detect_targets():
    targets = ["claude"]
    if GEMINI_DIR.exists():
        targets.append("gemini")
    return targets


def target_dirs(targets):
    dirs = [CLAUDE_SKILLS]
    if "gemini" in targets:
        dirs.append(GEMINI_SKILLS)
    return dirs


def _managed_link(link, roots):
    target = Path(os.readlink(link))
    if not target.is_absolute():
        target = (link.parent / target)
    target = Path(os.path.abspath(target))
    return any(target == r or r in target.parents for r in roots)


def _legacy_link(link, known, roots):
    """A link named after a god-mode skill that a pre-1.0 install left behind.

    Those links point into ~/.gemini/config/plugins/<pack>/skills/, or chain through the other
    skills folder (~/.claude/skills <-> ~/.gemini/config/skills). Links with other names are never touched.
    """
    if link.name not in known:
        return False
    first_hop = Path(os.readlink(link))
    if not first_hop.is_absolute():
        first_hop = link.parent / first_hop
    first_hop = Path(os.path.abspath(first_hop))
    chains_to_other_folder = first_hop.parent in (CLAUDE_SKILLS, GEMINI_SKILLS) and first_hop.parent != link.parent
    if chains_to_other_folder and (first_hop.is_symlink() or not os.path.lexists(first_hop)):
        return True
    resolved = Path(os.path.realpath(link))
    legacy_roots = {Path(os.path.realpath(r)) for r in (*roots, LEGACY_GEMINI_PLUGINS)}
    return any(resolved == r or r in resolved.parents for r in legacy_roots)


def legacy_gemini_plugins(known):
    """Plugin folders in ~/.gemini/config/plugins that repeat god-mode skills, with how many they repeat."""
    if not LEGACY_GEMINI_PLUGINS.is_dir():
        return []
    found = []
    for plugin in sorted(p for p in LEGACY_GEMINI_PLUGINS.iterdir() if p.is_dir()):
        repeated = {s.parent.name for s in plugin.glob("skills/*/SKILL.md")} & known
        if repeated:
            found.append((plugin, len(repeated)))
    return found


def apply_pack(pack_name):
    repo = ensure_source_dir()
    selected, missing = pack_skills(repo, pack_name)
    targets = load_state().get("targets") or detect_targets()
    roots = managed_roots(repo)
    known = set(discover_skills(repo))

    print(f"\n{PURPLE}{BOLD}⚡ Aplicando pack '{pack_name.upper()}' ({len(selected)} skills)...{NC}")
    if missing:
        print(f"{YELLOW}⚠️  El pack menciona skills que no existen en el repo: {', '.join(missing)}{NC}")

    conflicts = []
    migrated = 0
    for skills_dir in target_dirs(targets):
        skills_dir.mkdir(parents=True, exist_ok=True)
        for item in skills_dir.iterdir():
            if not item.is_symlink():
                continue
            if _managed_link(item, roots):
                item.unlink()
            elif _legacy_link(item, known, roots):
                item.unlink()
                migrated += 1
        for name, src in selected.items():
            dest = skills_dir / name
            if dest.is_symlink() or dest.exists():
                conflicts.append(str(dest))
                continue
            dest.symlink_to(src, target_is_directory=True)

    save_state(active_pack=pack_name, skills_count=len(selected), targets=targets)

    print(f"{GREEN}✓ Pack '{pack_name}' activado.{NC}")
    if migrated:
        print(f"  {GREEN}✓ {migrated} enlaces de una instalación anterior a 1.0 reemplazados por los de esta versión{NC}")
    for skills_dir in target_dirs(targets):
        managed = sum(1 for i in skills_dir.iterdir() if i.is_symlink() and _managed_link(i, roots))
        print(f"  • {skills_dir}: {managed} skills de god-mode")
        if managed < len(selected):
            print(f"{YELLOW}⚠️  Solo {managed} de las {len(selected)} skills del pack quedaron activas en {skills_dir}.{NC}")
    if conflicts:
        print(f"{YELLOW}⚠️  Se mantuvieron {len(conflicts)} skills propias con el mismo nombre que una de god-mode."
              f" Tienen prioridad sobre la versión de god-mode:{NC}")
        for c in conflicts:
            print(f"     {c}")
        print(f"   Si son copias de una instalación anterior, movelas a otra carpeta y corré"
              f" `god-mode pack {pack_name}`.")
    if "gemini" in targets:
        for plugin, repeated in legacy_gemini_plugins(known):
            print(f"{YELLOW}⚠️  Antigravity también carga {plugin}, que repite {repeated} de las skills de god-mode."
                  f" Si es de una instalación anterior, movelo fuera de {LEGACY_GEMINI_PLUGINS}.{NC}")
    if pack_name != "all":
        print(f"{CYAN}💡 Pack parcial: solo {len(selected)} skills ocupan contexto.{NC}")
    print()


def backup_path(path):
    stamp = datetime.datetime.now().astimezone().strftime("%Y%m%d-%H%M%S-%f")
    candidate = path.with_name(f"{path.name}.bak-{stamp}")
    n = 1
    while candidate.exists() or candidate.is_symlink():
        candidate = path.with_name(f"{path.name}.bak-{stamp}-{n}")
        n += 1
    return candidate


def backup(path):
    bak = backup_path(path)
    shutil.copy2(path, bak)
    return bak


def legacy_protocols(repo):
    """Every CLAUDE.md the pre-1.0 installer could have written, newest first."""
    return [f.read_text(encoding="utf-8").replace("\r\n", "\n").strip()
            for f in sorted((repo / "config" / "legacy").glob("*.md"), reverse=True)]


def rule_files(repo):
    return sorted((repo / "config" / "rules").glob("*.md"))


def protocol_text(repo):
    """config/CLAUDE.md followed by every global rule in config/rules/."""
    src = repo / "config" / "CLAUDE.md"
    if not src.exists():
        fail(f"No existe {src}")
    parts = [src.read_text(encoding="utf-8").strip()]
    parts += [r.read_text(encoding="utf-8").strip() for r in rule_files(repo)]
    return "\n\n---\n\n".join(parts)


def sync_claude_md(repo):
    block = f"{BLOCK_START}\n{protocol_text(repo)}\n{BLOCK_END}"

    if not CLAUDE_MD.exists() and not CLAUDE_MD.is_symlink():
        atomic_write(CLAUDE_MD, block + "\n")
        print(f"  {GREEN}✓ Creado {CLAUDE_MD}{NC}")
        return
    try:
        current = CLAUDE_MD.read_text(encoding="utf-8")
    except FileNotFoundError:
        fail(f"{CLAUDE_MD} es un enlace simbólico roto. Corregilo y volvé a correr.")
    except UnicodeDecodeError:
        fail(f"{CLAUDE_MD} no está en UTF-8. Convertilo a UTF-8 y volvé a correr; no se modificó nada.")

    starts, ends = current.count(BLOCK_START), current.count(BLOCK_END)
    if starts > 1 or ends > 1:
        fail(f"{CLAUDE_MD} tiene más de un bloque de god-mode. Dejá uno solo y volvé a correr; no se modificó nada.")
    if starts == 1 and ends == 1:
        start = current.index(BLOCK_START)
        end = current.index(BLOCK_END) + len(BLOCK_END)
        if end < start:
            fail(f"Los marcadores de god-mode en {CLAUDE_MD} están desordenados. Corregilos a mano.")
        updated = current[:start] + block + current[end:]
        if updated == current:
            print(f"  {BLUE}ℹ {CLAUDE_MD} ya tiene la última versión del protocolo{NC}")
            return
        atomic_write(CLAUDE_MD, updated)
        print(f"  {GREEN}✓ Protocolo actualizado en {CLAUDE_MD}{NC}")
        return
    if starts or ends:
        fail(f"{CLAUDE_MD} tiene solo uno de los marcadores de god-mode. Corregilo a mano y volvé a correr.")

    normalized = current.replace("\r\n", "\n")
    for old in legacy_protocols(repo):
        if old and old in normalized:
            bak = backup(CLAUDE_MD)
            atomic_write(CLAUDE_MD, normalized.replace(old, block, 1))
            print(f"  {GREEN}✓ Protocolo anterior reemplazado en {CLAUDE_MD}; tus reglas propias se conservaron{NC}")
            print(f"  {YELLOW}  Copia de la versión anterior: {bak}{NC}")
            return

    legacy = LEGACY_HEADER.search(normalized)
    bak = backup(CLAUDE_MD)
    atomic_write(CLAUDE_MD, current.rstrip() + "\n\n" + block + "\n")
    print(f"  {GREEN}✓ Protocolo agregado al final de {CLAUDE_MD}{NC}  (copia previa: {bak})")
    if legacy:
        line = normalized[:legacy.start()].count("\n") + 1
        print(f"{YELLOW}{BOLD}⚠️  {CLAUDE_MD} todavía tiene una copia modificada del protocolo anterior (línea {line}).{NC}")
        print(f"{YELLOW}   No la borré para no perder cambios tuyos, pero sigue activa y contradice al protocolo nuevo")
        print(f"   (por ejemplo, instalar skills sin pedir confirmación). Borrá a mano la sección que empieza en la línea {line}.{NC}")


def install_file(src, dest, label, keep_backup=True):
    dest.parent.mkdir(parents=True, exist_ok=True)
    if dest.exists() and dest.read_bytes() == src.read_bytes():
        return False
    if dest.exists() and keep_backup:
        bak = backup(dest)
        print(f"  {YELLOW}  {label}: copia de la versión anterior en {bak}{NC}")
    shutil.copy2(src, dest)
    return True


def install_cli(repo):
    cli = repo / "bin" / "god-mode"
    if not cli.exists():
        return
    if install_file(cli, LOCAL_BIN, "CLI", keep_backup=False):
        print(f"  {GREEN}✓ CLI actualizado en {LOCAL_BIN}{NC}")
    LOCAL_BIN.chmod(0o755)
    if LEGACY_BIN.exists() and LEGACY_BIN.read_bytes() != cli.read_bytes():
        if os.access(LEGACY_BIN, os.W_OK):
            shutil.copy2(cli, LEGACY_BIN)
            print(f"  {GREEN}✓ También se actualizó la copia vieja en {LEGACY_BIN}{NC}")
        else:
            print(f"{YELLOW}⚠️  Hay una versión vieja del CLI en {LEGACY_BIN} que no puedo actualizar.")
            print(f"   Borrala con: sudo rm {LEGACY_BIN}{NC}")
    found = shutil.which("god-mode")
    if found and Path(found).resolve() != LOCAL_BIN.resolve():
        print(f"{YELLOW}⚠️  En tu PATH, 'god-mode' apunta a {found} y no a {LOCAL_BIN}. Poné ~/.local/bin primero en el PATH.{NC}")


def cmd_setup(targets):
    repo = ensure_source_dir()
    remember_source(repo)
    save_state(targets=targets)
    print(f"\n{BOLD}🧠 Configurando protocolo, agentes e instalador de skills...{NC}")

    install_cli(repo)
    sync_claude_md(repo)

    installer = repo / "scripts" / "install-skill.py"
    if installer.exists():
        install_file(installer, CLAUDE_SCRIPTS / "install-skill.py", "install-skill.py")
        (CLAUDE_SCRIPTS / "install-skill.py").chmod(0o755)

    agents = discover_agents(repo)
    changed = sum(install_file(a, CLAUDE_AGENTS / a.name, f"Agente {a.name}") for a in agents)
    print(f"  {GREEN}✓ {len(agents)} subagentes en {CLAUDE_AGENTS} ({changed} actualizados){NC}")

    if "gemini" in targets:
        rules = repo / "config" / "GEMINI_RULES.md"
        if rules.exists():
            install_file(rules, GEMINI_RULES, "Reglas de Antigravity")
        for rule in rule_files(repo):
            install_file(rule, GEMINI_RULES.parent / rule.name, f"Regla {rule.name}")
        print(f"  {GREEN}✓ Reglas de Antigravity en {GEMINI_RULES.parent}{NC}")


def cmd_update():
    print(f"\n{BOLD}{PURPLE}🔄 Actualizando god-mode desde GitHub...{NC}")
    repo = ensure_source_dir()
    if not (repo / ".git").exists():
        fail(f"{repo} no es un repositorio git; no se puede actualizar. Reinstalá con install.sh.")
    ref = run_git(["symbolic-ref", "-q", "HEAD"], cwd=repo, capture=True)
    if ref.returncode == 1:
        tag = run_git(["describe", "--tags", "--exact-match"], cwd=repo, capture=True).stdout.strip() or "un commit fijo"
        print(f"{YELLOW}ℹ La instalación está fijada en {tag}; no se actualiza sola.{NC}")
        print("  Para cambiar de versión: curl -fsSL https://raw.githubusercontent.com/Gastonchevarria/god-mode/main/install.sh"
              " | bash -s -- --version=vX.Y.Z")
        return
    if ref.returncode != 0:
        fail(f"git no pudo leer {repo} (código {ref.returncode}): {ref.stderr.strip()}")
    res = run_git(["pull", "--ff-only"], cwd=repo)
    if res.returncode != 0:
        fail(f"git pull falló en {repo} (código {res.returncode}). No se aplicó ningún cambio.")
    new_cli = repo / "bin" / "god-mode"
    if new_cli.exists():
        os.execv(sys.executable, [sys.executable, str(new_cli), "_finish-update"])
    finish_update()


def finish_update():
    state = load_state()
    cmd_setup(state.get("targets") or detect_targets())
    apply_pack(state.get("active_pack", "core"))
    print(f"{GREEN}{BOLD}🎉 god-mode actualizado.{NC}\n")


def cmd_status():
    state = load_state()
    repo = source_dir()
    active = state.get("active_pack", "ninguno")
    targets = state.get("targets") or detect_targets()
    agents = len(list(CLAUDE_AGENTS.glob("*.md"))) if CLAUDE_AGENTS.exists() else 0
    print(f"\n{PURPLE}{BOLD}⚡ DEV GOD-MODE STATUS{NC}")
    print("────────────────────────────────────────────────────")
    print(f"  • Repositorio:     {repo or 'no encontrado'}")
    print(f"  • Pack activo:     {GREEN}{BOLD}{active.upper()}{NC}")
    print(f"  • Destinos:        {', '.join(targets)}")
    for d in target_dirs(targets):
        count = len(list(d.iterdir())) if d.exists() else 0
        print(f"  • {d}: {CYAN}{count}{NC} skills")
    print(f"  • Subagentes:      {CYAN}{agents}{NC}")
    if repo:
        packs = load_packs(repo)
        total = len(discover_skills(repo))
        print("────────────────────────────────────────────────────\nPacks disponibles:")
        for name, skills in packs.items():
            count = total if skills == "ALL" else len(skills)
            print(f"  • {BOLD}{name}{NC}: {count} skills")
    print("\nPara cambiar de pack:  god-mode pack <nombre>\n")


def cmd_cursor(target_dir="."):
    repo = ensure_source_dir()
    target = Path(target_dir).resolve()
    print(f"{BOLD}Inyectando reglas de god-mode para Cursor y Windsurf en:{NC} {target}")
    for name in (".cursorrules", "AGENTS.md"):
        src = repo / "config" / name
        if not src.exists():
            continue
        if install_file(src, target / name, name):
            print(f"  {GREEN}✓ {target / name}{NC}")
        else:
            print(f"  {BLUE}ℹ {target / name} ya estaba actualizado{NC}")


RECOMMENDED_ENV = {
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-sonnet-5-5",
    "AUTOHARNESS_REFLECT_EVERY_N": "75",
    "AUTOHARNESS_CONSOLIDATE_EVERY_N": "300",
}
TOKEN_RULE_SECTIONS = ["Brevedad Obligatoria", "Context Hygiene", "Tool Call Discipline",
                       "Output Frugality", "Auto-Compact Triggers", "Smart Skill Loading"]


def _shell_rc_value(name):
    for rc in (HOME / ".zshrc", HOME / ".bashrc", HOME / ".profile"):
        try:
            text = rc.read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
        m = None
        for m in re.finditer(rf"^\s*export\s+{name}=[\"']?([^\"'\s]+)", text, re.MULTILINE):
            pass
        if m:
            return m.group(1), rc
    return None, None


def _managed_links(skills_dir):
    repo = source_dir()
    roots = managed_roots(repo) if repo else set()
    return [i for i in skills_dir.iterdir() if i.is_symlink() and _managed_link(i, roots)] if skills_dir.exists() else []


def _read_settings(path):
    """Claude Code user settings as a dict; None when the file exists but is not a JSON object."""
    if not path.exists():
        return {}
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return None
    return data if isinstance(data, dict) else None


def fix_claude_settings(path):
    """Writes the recommended outputStyle and env into Claude Code's settings, keeping every other key."""
    data = _read_settings(path)
    if data is None or not isinstance(data.get("env", {}), dict):
        fail(f"No toco {path}: no es un JSON válido con \"env\" como objeto. Corregilo a mano y volvé a correr.")
    env = dict(data.get("env", {}))
    changes = []
    if data.get("outputStyle") != "Concise":
        changes.append(f"outputStyle: {data.get('outputStyle') or '—'} → Concise")
        data["outputStyle"] = "Concise"
    for name, value in RECOMMENDED_ENV.items():
        if env.get(name) != value:
            changes.append(f"env.{name}: {env.get(name) or '—'} → {value}")
            env[name] = value
    if not changes:
        print(f"{GREEN}✓ {path} ya tenía la configuración recomendada.{NC}")
        return
    data["env"] = env
    bak = backup(path) if path.exists() else None
    target = path.resolve()  # a settings.json symlinked from a dotfiles repo stays a symlink
    target.parent.mkdir(parents=True, exist_ok=True)
    tmp = target.with_name(f"{target.name}.tmp-god-mode")
    tmp.write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
    if target.exists():
        shutil.copymode(target, tmp)
    os.replace(tmp, target)
    print(f"{GREEN}✓ {path} actualizado{NC}" + (f"  (copia previa: {bak})" if bak else ""))
    for change in changes:
        print(f"  • {change}")
    print(f"  {CYAN}Abrí una sesión nueva de Claude Code para que tome efecto.{NC}")


def _claude_plugins():
    """Enabled Claude Code plugin ids, or None when `claude` is missing or does not answer."""
    if not shutil.which("claude"):
        return None
    try:
        out = subprocess.run(["claude", "plugin", "list", "--json"], capture_output=True, text=True, timeout=60,
                             check=False).stdout
        return [p["id"] for p in json.loads(out) if p.get("enabled", True) and p.get("id")]
    except (subprocess.TimeoutExpired, OSError, json.JSONDecodeError, TypeError, KeyError):
        pass
    try:
        out = subprocess.run(["claude", "plugin", "list"], capture_output=True, text=True, timeout=60,
                             check=False).stdout
    except (subprocess.TimeoutExpired, OSError):
        return None
    return re.findall(r"^\s*>\s*(\S+@\S+)", out, re.MULTILINE)


def _check_skills_dir(skills_dir, expected, label, results):
    links = _managed_links(skills_dir)
    broken = [i.name for i in links if not i.exists()]
    ok = len(links) == len(expected) and not broken
    detail = f"{len(links)} enlazadas, se esperaban {len(expected)} del pack activo"
    if broken:
        detail += f"; {len(broken)} enlaces rotos"
    results.append((ok, f"{label}: skills del pack", detail, "god-mode update"))
    auto = skills_dir / "auto-compact" / "SKILL.md"
    results.append((auto.exists(), f"{label}: skill auto-compact", str(auto) if auto.exists() else "no instalada",
                    "god-mode update"))
    god = skills_dir / "god" / "SKILL.md"
    has_route = god.exists() and "CONTEXT-HEALTH" in god.read_text(encoding="utf-8", errors="replace")
    results.append((has_route, f"{label}: ruta CONTEXT-HEALTH en /god", "presente" if has_route else "falta",
                    "god-mode update"))


def cmd_doctor(fix=False):
    results = []
    state = load_state()
    repo = source_dir()
    if not repo:
        fail("No encontré el repositorio de god-mode. Instalalo con install.sh.")
    settings_path = CLAUDE_DIR / "settings.json"
    if fix:
        print(f"\n{PURPLE}{BOLD}⚡ god-mode doctor --fix{NC}")
        fix_claude_settings(settings_path)
    targets = state.get("targets") or detect_targets()
    expected = pack_skills(repo, state.get("active_pack", "core"))[0]

    text = CLAUDE_MD.read_text(encoding="utf-8", errors="replace") if CLAUDE_MD.exists() else ""
    results.append((BLOCK_START in text, "Claude Code: protocolo en CLAUDE.md", str(CLAUDE_MD), "god-mode update"))
    for needle, label in (("Límites de autonomía", "límites de autonomía"),
                          ("Token Optimization Protocol", "regla de optimización de tokens")):
        results.append((needle in text, f"Claude Code: {label} en CLAUDE.md", "presente" if needle in text else "falta",
                        "god-mode update"))
    _check_skills_dir(CLAUDE_SKILLS, expected, "Claude Code", results)
    agents = len(list(CLAUDE_AGENTS.glob("*.md"))) if CLAUDE_AGENTS.exists() else 0
    wanted = len(discover_agents(repo))
    results.append((agents >= wanted, "Claude Code: subagentes", f"{agents} instalados, se esperaban {wanted}",
                    "god-mode update"))

    if "gemini" in targets:
        dev = GEMINI_RULES.read_text(encoding="utf-8", errors="replace") if GEMINI_RULES.exists() else ""
        ok = "Límites de autonomía" in dev and "⚡ **GOD** · Ruta" in dev
        results.append((ok, "Antigravity: dev_god_mode.md", str(GEMINI_RULES) if dev else "no existe", "god-mode update"))
        tok_path = GEMINI_RULES.parent / "token-optimization.md"
        tok = tok_path.read_text(encoding="utf-8", errors="replace") if tok_path.exists() else ""
        missing = [sec for sec in TOKEN_RULE_SECTIONS if sec not in tok]
        results.append((not missing, "Antigravity: token-optimization.md",
                        "completo" if not missing else f"faltan: {', '.join(missing)}", "god-mode update"))
        _check_skills_dir(GEMINI_SKILLS, expected, "Antigravity", results)

    settings = _read_settings(settings_path)
    settings_env = (settings or {}).get("env")
    settings_env = settings_env if isinstance(settings_env, dict) else {}
    for name, value in RECOMMENDED_ENV.items():
        # Claude Code applies settings.json "env" over the shell's environment, so it is checked first.
        if name in settings_env:
            current, where = str(settings_env[name]), str(settings_path)
        else:
            current, where = os.environ.get(name), "entorno actual"
        if current is None:
            current, rc = _shell_rc_value(name)
            where = str(rc) if rc else "no definida"
        results.append((current == value, f"Variable {name}", f"{current or '—'} ({where})", "god-mode doctor --fix"))

    style = (settings or {}).get("outputStyle")
    results.append(((style or "").lower() == "concise", "Claude Code: output style Concise",
                    style or ("settings.json inválido" if settings is None else "sin definir"), "god-mode doctor --fix"))

    plugins = _claude_plugins()
    if plugins is None:
        results.append((None, "Claude Code: plugins", "claude no está en el PATH o no respondió", ""))
    else:
        own = sorted(p for p in plugins if p.endswith("@god-mode"))
        links = len(_managed_links(CLAUDE_SKILLS))
        if own:
            dup = links > 0
            detail = f"plugins {', '.join(own)}" + (f" y además {links} skills enlazadas por el CLI" if dup else "")
            results.append((not dup, "Claude Code: god-mode cargado una sola vez", detail,
                            f"quedate con una ruta: claude plugin uninstall {' '.join(own)}  (el CLI ya carga todo)"))
        has = any("autoharness" in p.lower() for p in plugins)
        results.append((has, "Claude Code: plugin AutoHarness", "instalado" if has else "no instalado",
                        "/plugin marketplace add tigerless-labs/autoharness y /plugin install autoharness@autoharness"))

    print(f"\n{PURPLE}{BOLD}⚡ god-mode doctor{NC}\n")
    failed = 0
    for ok, name, detail, remedy in results:
        mark = f"{GREEN}✓{NC}" if ok else (f"{BLUE}–{NC}" if ok is None else f"{RED}✗{NC}")
        print(f"  {mark} {name}: {detail}")
        if ok is False:
            failed += 1
            print(f"      → {remedy}")
    total = sum(1 for r in results if r[0] is not None)
    print(f"\n{total - failed}/{total} verificaciones en verde.\n")
    sys.exit(1 if failed else 0)


USAGE = f"""
{PURPLE}{BOLD}⚡ god-mode CLI — Gestor de la suite DEV GOD-MODE{NC}

{BOLD}Uso:{NC}
  god-mode <comando> [opciones]

{BOLD}Comandos:{NC}
  {CYAN}status{NC}                 Estado del sistema, pack activo y skills instaladas.
  {CYAN}pack <nombre>{NC}          Cambia el pack activo (ver `god-mode status`).
  {CYAN}update{NC}                 Actualiza desde GitHub y reaplica protocolo, agentes y pack.
  {CYAN}cursor [ruta]{NC}          Copia .cursorrules y AGENTS.md a un proyecto (con copia de respaldo).
  {CYAN}add <github-url>{NC}       Instala una skill desde GitHub (pide confirmación).
  {CYAN}doctor [--fix]{NC}         Verifica la instalación; con --fix escribe outputStyle y env recomendados
                         en ~/.claude/settings.json (con copia de respaldo).
  {CYAN}setup [--targets=claude,gemini] [--source=<repo>]{NC}
                         Instala protocolo, agentes e instalador (lo usa install.sh).
"""


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help", "help"):
        print(USAGE)
        return
    cmd = args[0].lower()
    if cmd == "status":
        cmd_status()
    elif cmd == "pack":
        if len(args) < 2:
            fail("Especificá un pack. Ej: god-mode pack core")
        apply_pack(args[1].lower())
    elif cmd == "update":
        cmd_update()
    elif cmd == "_finish-update":
        finish_update()
    elif cmd == "cursor":
        cmd_cursor(args[1] if len(args) > 1 else ".")
    elif cmd == "setup":
        targets = detect_targets()
        for a in args[1:]:
            if a.startswith("--targets="):
                targets = [t for t in a.split("=", 1)[1].split(",") if t in ("claude", "gemini")] or ["claude"]
            elif a.startswith("--source="):
                src = Path(a.split("=", 1)[1]).expanduser().resolve()
                if not is_repo(src):
                    fail(f"{src} no es un repositorio de god-mode (falta config/packs.json).")
                remember_source(src)
        cmd_setup(targets)
    elif cmd == "add":
        if len(args) < 2:
            fail("Especificá una URL de GitHub. Ej: god-mode add https://github.com/owner/repo")
        installer = CLAUDE_SCRIPTS / "install-skill.py"
        if not installer.exists():
            fail(f"No existe {installer}. Corré `god-mode setup` primero.")
        sys.exit(subprocess.run([sys.executable, str(installer), *args[1:]], check=False).returncode)
    elif cmd == "doctor":
        cmd_doctor(fix="--fix" in args[1:])
    elif cmd == "packs":
        repo = ensure_source_dir()
        print(" ".join(load_packs(repo)))
    else:
        fail(f"Comando desconocido: {cmd}. Ejecutá 'god-mode --help'")


if __name__ == "__main__":
    main()
